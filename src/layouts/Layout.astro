---
import { path } from '../site.js';
const { title, description = '物語を楽しみながら、英語を学ぶ。英語学習アプリTapeの公式サイトとサポート。' } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Tape</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffd600" />
    <link rel="icon" type="image/svg+xml" href={path('Tape-logo.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <header class="wrap">
      <button class="menu-toggle" type="button" aria-label="メニューを開く" aria-controls="site-menu" aria-expanded="false">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
      <a class="brand" href={path()} aria-label="Tape トップ"><img src={path('Tape-logo.svg')} width="120" height="50" alt="Tape" /></a>
    </header>
    <dialog id="site-menu" class="sidebar" aria-labelledby="menu-title">
      <div class="sidebar-head"><h2 id="menu-title">メニュー</h2><button class="menu-close" type="button" autofocus>閉じる <span aria-hidden="true">×</span></button></div>
      <nav aria-label="メインナビゲーション">
        <a href={path()} aria-current={Astro.url.pathname === path() ? 'page' : undefined}>ホーム</a>
        <a href={path('support/')} aria-current={Astro.url.pathname === path('support/') ? 'page' : undefined}>サポート</a>
        <a href={path('privacy/')} aria-current={Astro.url.pathname === path('privacy/') ? 'page' : undefined}>プライバシーポリシー</a>
      </nav>
    </dialog>
    <main id="main" class="wrap"><slot /></main>
    <footer class="wrap"><a class="brand" href={path()}>Tape</a><nav aria-label="フッター"><a href={path('support/')}>サポート</a><a href={path('privacy/')}>プライバシーポリシー</a><a href={path('legal/')}>特定商取引法に基づく表記</a></nav><small>© {new Date().getFullYear()} Tape</small></footer>
  </body>
</html>
<script>
  const menu = document.querySelector<HTMLDialogElement>('#site-menu');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const close = document.querySelector<HTMLButtonElement>('.menu-close');
  if (menu && toggle && close) {
    toggle.addEventListener('click', () => {
      menu.showModal();
      toggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('menu-open');
    });
    close.addEventListener('click', () => menu.close());
    menu.addEventListener('click', (event) => {
      const bounds = menu.getBoundingClientRect();
      if (event.target === menu && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) menu.close();
    });
    menu.addEventListener('close', () => {
      toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('menu-open');
      toggle.focus();
    });
  }
</script>
<style is:global>
  :root{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Hiragino Kaku Gothic ProN","Yu Gothic",Meiryo,sans-serif;color:#000;background:#fff;font-synthesis:none;--muted:#000}
  *{box-sizing:border-box}
  body{margin:0;font-size:18px;line-height:1.9}
  a{color:#000;text-underline-offset:4px;overflow-wrap:anywhere}
  a:hover{color:#000;text-decoration-thickness:2px}
  a:focus-visible,summary:focus-visible,button:focus-visible{outline:3px solid #8b7200;outline-offset:5px}
  .wrap{width:min(800px,calc(100% - 48px));margin-inline:auto}
  header{min-height:88px;display:flex;align-items:center;border-bottom:1px solid #e2e6e0;background:#ffd600;box-shadow:0 0 0 100vmax #ffd600;clip-path:inset(0 -100vmax)}
  .brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none;font-size:26px;font-weight:750;color:#000;line-height:1.3}
  .brand img{display:block;width:120px;height:auto}
  button{font:inherit;color:#000;cursor:pointer}
  .menu-toggle{margin-right:20px;display:inline-flex;align-items:center;justify-content:center;width:48px;height:48px;flex-shrink:0;padding:12px;background:transparent;border:0;border-radius:6px}
  .menu-toggle:hover,.menu-close:hover{background:#f3f3f3}
  body.menu-open{overflow:hidden}
  .sidebar{position:fixed;inset:0 auto 0 0;margin:0;width:min(380px,90vw);height:100%;height:100dvh;max-width:none;max-height:none;padding:28px 24px;border:0;border-right:1px solid #ddd;background:#fff;color:#000;overflow-y:auto}
  .sidebar::backdrop{background:rgb(0 0 0 / 35%)}
  .sidebar-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px}
  .sidebar-head h2{margin:0;font-size:22px}
  .menu-close{min-height:48px;padding:8px 12px;border:0;border-radius:6px;background:#fff;font-size:16px}
  .menu-close span{margin-left:6px;font-size:24px}
  .sidebar nav{display:flex;flex-direction:column;gap:8px}
  .sidebar nav a{display:block;padding:16px 12px;border-radius:6px;text-decoration:none;font-weight:600}
  .sidebar nav a:hover{background:#f3f3f3;text-decoration:underline}
  .sidebar nav a[aria-current="page"]{background:#fff5bf}
  nav{display:flex;gap:24px;flex-wrap:wrap}main{min-height:65vh}
  h1{font-size:clamp(28px,4.5vw,38px);line-height:1.5;margin:0 0 16px;overflow-wrap:anywhere}
  h2{font-size:24px;line-height:1.6;margin:0 0 16px}
  p{color:var(--muted);margin:16px 0;overflow-wrap:anywhere}li{margin:6px 0;color:var(--muted)}ul{padding-left:24px}
  .page-head{padding:48px 0 24px}.page-head p{margin:0}
  .article{padding-bottom:56px}.article section{margin:32px 0 0}.policy section{border-top:1px solid #e2e6e0;padding-top:28px}
  .notice,.required{background:#fff8e5;border-left:3px solid #a77813;padding:14px 18px;color:#000;border-radius:0 6px 6px 0;font-size:18px}
  .button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:10px 22px;border-radius:6px;background:#ffd600;color:#000;text-decoration:none;font-weight:650}
  .button:hover{background:#f0c900;color:#000}
  .panel{background:#f6f8f5;border:1px solid #e0e6dd;border-radius:8px;padding:28px}.panel>p:first-of-type{margin-top:0}
  details{border-bottom:1px solid #e2e6e0}summary{cursor:pointer;font-weight:650;line-height:1.7;padding:20px 4px}details p{padding:0 4px 12px;margin-top:0}
  dt{font-weight:650;margin-top:16px}dd{margin:8px 0 0}
  footer{border-top:1px solid #e2e6e0;padding:28px 0 36px;display:flex;gap:24px;align-items:center;flex-wrap:wrap;background:#e8e8e8;box-shadow:0 0 0 100vmax #e8e8e8;clip-path:inset(0 -100vmax)}footer .brand{font-size:22px}footer nav{font-size:16px;gap:8px 24px}footer nav a{padding:8px 0}footer small{width:100%;color:var(--muted);font-size:16px}
  .skip{position:absolute;left:16px;top:-80px;background:white;padding:12px;z-index:9}.skip:focus{top:12px}
  @media(max-width:600px){.wrap{width:calc(100% - 40px)}header{min-height:76px}.page-head{padding-top:32px}.panel{padding:20px}.article{padding-bottom:40px}footer{gap:12px}footer nav{width:100%}.required,.notice{padding:12px 14px}}
</style>
